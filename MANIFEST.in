include README.md VALIDATION.md THIRD_PARTY_NOTICES.txt constraints-dev.txt
recursive-include docs *.md
recursive-include fixtures *.dxf *.md
recursive-include reports *.json *.txt
recursive-include scripts *.py
recursive-include tests *.py
recursive-include src/dxf_preflight *.py *.json
prune .venv
prune .pytest_cache
prune build
prune dist
prune local-reports
global-exclude *.pyc __pycache__
